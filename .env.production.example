# Copy to .env.production on the destination host; keep it out of image contexts.
APP_IMAGE_TAG=20261029
# Build this archive locally with: node deploy/package.mjs --prebuilt
# The source-build alternative is Dockerfile, suitable for a larger build host.
APP_DOCKERFILE=Dockerfile.prebuilt
NODE_IMAGE=node:22-bookworm-slim
MYSQL_IMAGE=mysql:8.4
# The host Nginx upstream must use this free loopback port.
APP_BIND_PORT=43101
MYSQL_DATABASE=lianduoduo
MYSQL_USER=lianduoduo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_CONNECTION_LIMIT=10
MYSQL_MEMORY_LIMIT=512m
APP_MEMORY_LIMIT=256m
NODE_MAX_OLD_SPACE_MB=128
PUBLIC_ORIGIN=https://lianduoduo.aiapaas.com
# Exact socket peer IP(s) of the host reverse proxy as seen inside this container.
# Keep empty until the deployed Docker gateway/proxy topology is verified.
TRUSTED_PROXY_IPS=
# Generate on the destination host; needed only to guard first administrator setup.
SETUP_TOKEN=
ALLOWED_ORIGINS=https://lianduoduo.aiapaas.com
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PHONE_LOGIN_ENABLED=false
WECHAT_API_TIMEOUT_MS=10000
