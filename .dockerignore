# Only application build inputs and deployment entry points enter the context.
**
!Dockerfile
!Dockerfile.prebuilt
!Dockerfile.prebuilt.dockerignore
!package.json
!package-lock.json
!index.html
!vite.local.config.ts
!tsconfig.json
!app/
!app/**
!frontend/
!frontend/**
!lib/
!lib/**
!public/
!public/**
!server/
!server/**
!local/
!local/env.mjs
!local/init-mysql.mjs
!scripts/
!scripts/compile-local.mjs
!deploy/
!deploy/start.mjs
!deploy/package.mjs
!deploy/runtime/
!deploy/runtime/package.json
!deploy/runtime/package-lock.json
# Defense in depth if a copied source directory later contains local artifacts.
**/.env
**/.env.*
**/node_modules
**/outputs
**/.git
**/*.pem
**/*.key
**/*.sql
**/*.sql.gz
**/*.tar
**/*.tar.gz
**/.DS_Store
