# Local API and admin UI. Keep loopback unless LAN access is needed.
HOST=127.0.0.1
API_PORT=43101
WEB_PORT=5173
# MySQL is the application database. All credentials stay on the server.
DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=43306
MYSQL_USER=lianduoduo
MYSQL_PASSWORD=
MYSQL_DATABASE=lianduoduo
MYSQL_CONNECTION_LIMIT=10
# Used only to initialize the local Docker MySQL service.
MYSQL_ROOT_PASSWORD=
# Optional schema initialization account; runtime always uses MYSQL_USER.
MYSQL_SCHEMA_USER=root
# Integration tests create and remove isolated lianduoduo_test_* databases.
MYSQL_TEST_HOST=127.0.0.1
MYSQL_TEST_PORT=43306
MYSQL_TEST_USER=root
MYSQL_TEST_PASSWORD=

# WeChat-only sign-in. Secret is used by the server and never bundled.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Native getPhoneNumber needs the corresponding capability enabled in WeChat.
WECHAT_PHONE_LOGIN_ENABLED=true
WECHAT_API_TIMEOUT_MS=10000

# Public configuration generated into miniprogram/config.js by dev/build/config:wechat.
MINIPROGRAM_API_BASE_URL=http://127.0.0.1:43101
# Trial/release builds use this public HTTPS endpoint; no server secrets are copied.
MINIPROGRAM_PRODUCTION_API_BASE_URL=https://lianduoduo.aiapaas.com
MINIPROGRAM_REQUEST_TIMEOUT_MS=15000
