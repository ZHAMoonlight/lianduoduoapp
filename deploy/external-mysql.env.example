# Merge only these database settings into the existing production environment.
# Keep all existing application, WeChat, PUBLIC_ORIGIN and SETUP_TOKEN values.
MYSQL_HOST=database-host.example
MYSQL_PORT=3306
MYSQL_DATABASE=lianduoduo
MYSQL_USER=lianduoduo
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10

# Optional explicit Docker host override. A container's 127.0.0.1 is not the host.
# Use host.docker.internal only if the host MySQL listens on an accessible address.
MYSQL_DOCKER_HOST=

# Optional one-time initialization account; never sent to the app container.
# MYSQL_SCHEMA_USER and MYSQL_SCHEMA_PASSWORD must be supplied together.
MYSQL_SCHEMA_USER=
MYSQL_SCHEMA_PASSWORD=
# Alternatively, explicitly select root only for initialization:
MYSQL_INITIALIZE_AS_ADMIN=false
MYSQL_ROOT_PASSWORD=
# Only creates MYSQL_DATABASE if missing; requires an explicit admin above.
# This does not delete, truncate, reset, or import business records.
MYSQL_CREATE_DATABASE=false
